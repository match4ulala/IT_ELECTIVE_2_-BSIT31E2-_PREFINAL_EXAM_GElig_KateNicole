<style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');

    :root {
        --coral: #F28076;
        --pink: #FFB6AF;
        --cream: #FAE0C7;
        --peach: #FBC193;
        --teal: #4EB09B;
        --dark: #2F3433;
        --muted: #737977;
        --white: #FFFFFF;
        --soft-white: #FFFDFC;
        --shadow: 0 12px 35px rgba(79, 65, 56, 0.08);
        --shadow-hover: 0 18px 45px rgba(79, 65, 56, 0.13);
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'DM Sans', sans-serif;
        background:
            radial-gradient(circle at 0% 0%, rgba(255,182,175,.25), transparent 28%),
            radial-gradient(circle at 100% 15%, rgba(78,176,155,.16), transparent 25%),
            var(--cream);
        color: var(--dark);
        min-height: 100vh;
        padding: 35px 18px 60px;
    }

    .container {
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
    }

    header {
        position: relative;
        overflow: hidden;
        background: var(--coral);
        color: white;
        padding: 42px 42px 38px;
        border-radius: 28px;
        margin-bottom: 28px;
        box-shadow: var(--shadow-hover);
    }

    header::before {
        content: "";
        position: absolute;
        width: 220px;
        height: 220px;
        border-radius: 50%;
        background: rgba(255,255,255,.13);
        right: -70px;
        top: -90px;
    }

    header::after {
        content: "";
        position: absolute;
        width: 130px;
        height: 130px;
        border-radius: 50%;
        background: rgba(251,193,147,.28);
        right: 110px;
        bottom: -90px;
    }

    .header-content {
        position: relative;
        z-index: 2;
    }

    header h1 {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: clamp(1.5rem, 4vw, 2.2rem);
        line-height: 1.2;
        letter-spacing: -0.8px;
        margin-bottom: 10px;
    }

    header p {
        font-size: .98rem;
        color: rgba(255,255,255,.9);
        max-width: 650px;
    }

    .header-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 22px;
    }

    .header-pill {
        background: rgba(255,255,255,.18);
        border: 1px solid rgba(255,255,255,.25);
        padding: 7px 13px;
        border-radius: 100px;
        font-size: .8rem;
        font-weight: 600;
        backdrop-filter: blur(5px);
    }

    .palette-strip {
        display: flex;
        gap: 6px;
        height: 9px;
        margin: -10px 25px 28px;
        position: relative;
        z-index: 3;
    }

    .palette-strip span {
        flex: 1;
        border-radius: 20px;
    }

    .palette-strip span:nth-child(1) {
        background: var(--coral);
    }

    .palette-strip span:nth-child(2) {
        background: var(--pink);
    }

    .palette-strip span:nth-child(3) {
        background: var(--cream);
    }

    .palette-strip span:nth-child(4) {
        background: var(--peach);
    }

    .palette-strip span:nth-child(5) {
        background: var(--teal);
    }

    .question-card {
        position: relative;
        background: rgba(255,255,255,.88);
        border: 1px solid rgba(242,128,118,.12);
        border-radius: 22px;
        padding: 25px;
        margin-bottom: 18px;
        box-shadow: var(--shadow);
        transition: transform .25s ease, box-shadow .25s ease;
    }

    .question-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-hover);
    }

    .question-card:nth-child(5n + 1) {
        border-top: 5px solid var(--coral);
    }

    .question-card:nth-child(5n + 2) {
        border-top: 5px solid var(--pink);
    }

    .question-card:nth-child(5n + 3) {
        border-top: 5px solid var(--peach);
    }

    .question-card:nth-child(5n + 4) {
        border-top: 5px solid var(--teal);
    }

    .question-card:nth-child(5n + 5) {
        border-top: 5px solid var(--cream);
    }

    .question-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 17px;
    }

    .item-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 78px;
        background: var(--dark);
        color: white;
        font-size: .78rem;
        font-weight: 700;
        padding: 7px 12px;
        border-radius: 100px;
    }

    .topic-badge {
        color: var(--dark);
        background: var(--cream);
        font-size: .74rem;
        font-weight: 700;
        padding: 7px 12px;
        border-radius: 100px;
        text-align: right;
    }

    .question-text {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.05rem;
        font-weight: 700;
        line-height: 1.55;
        color: var(--dark);
        margin-bottom: 17px;
    }

    .options-list {
        list-style: none;
        margin-bottom: 17px;
    }

    .option-item {
        position: relative;
        padding: 13px 15px;
        border-radius: 12px;
        margin-bottom: 8px;
        border: 1px solid #eee7e1;
        background: var(--soft-white);
        color: #555b59;
        font-size: .91rem;
        line-height: 1.45;
        transition: all .2s ease;
    }

    .option-item:hover {
        background: #fff6f2;
        border-color: var(--pink);
        transform: translateX(3px);
    }

    .option-item.correct {
        background: rgba(78,176,155,.14);
        border: 1.5px solid var(--teal);
        color: #276e61;
        font-weight: 700;
        padding-right: 145px;
    }

    .option-item.correct::after {
        content: "✓ Correct";
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: var(--teal);
        color: white;
        padding: 5px 9px;
        border-radius: 100px;
        font-size: .7rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .explanation-box {
        position: relative;
        background: linear-gradient(
            135deg,
            rgba(250,224,199,.65),
            rgba(255,182,175,.18)
        );
        border: 1px solid rgba(242,128,118,.18);
        border-radius: 14px;
        padding: 15px 17px;
        font-size: .86rem;
        line-height: 1.6;
        color: #625b57;
    }

    .explanation-title {
        display: flex;
        align-items: center;
        gap: 6px;
        font-weight: 800;
        color: var(--coral);
        margin-bottom: 5px;
    }

    @media (max-width: 700px) {
        body {
            padding: 18px 12px 40px;
        }

        header {
            padding: 30px 24px;
            border-radius: 22px;
        }

        .question-card {
            padding: 19px;
            border-radius: 18px;
        }

        .question-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .topic-badge {
            text-align: left;
        }

        .option-item.correct {
            padding-right: 15px;
            padding-bottom: 43px;
        }

        .option-item.correct::after {
            top: auto;
            bottom: 9px;
            left: 12px;
            right: auto;
            transform: none;
        }

        .palette-strip {
            margin-left: 15px;
            margin-right: 15px;
        }
    }

    @media (max-width: 450px) {
        header h1 {
            font-size: 1.35rem;
        }

        header p {
            font-size: .88rem;
        }

        .question-text {
            font-size: .96rem;
        }

        .option-item {
            font-size: .86rem;
        }
    }
</style>
